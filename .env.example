DATABASE_URL=your_database_here

DATABASE_URL_UNPOOLED=your_unpool_database_here

APP_URL="http://localhost:3000"
# Must be at least 32 characters. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=replace-this-with-at-least-32-random-characters

# Optional: header your hosting proxy overwrites with the real client IP,
# e.g. cf-connecting-ip (Cloudflare), x-vercel-forwarded-for (Vercel), or
# true-client-ip. Strongly recommended in production for rate limiting.
# TRUSTED_IP_HEADER=cf-connecting-ip

BREVO_API_KEY=your_key_here
EMAIL_FROM=your_from_email
